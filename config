{
  "layer": "top",
  "output": "eDP-1",
  "position": "top",
  "margin-top": 0,
  "margin-bottom": 0,
  "spacing": 0,

  "modules-left": [
    "hyprland/workspaces",
    "custom/memory",
    "cpu",
    "wlr/taskbar"
  ],

  "modules-center": [
    "clock",
//    "custom/singapore",
    "custom/gcal",
    "custom/openrouter"
  ],

  "modules-right": [
    "custom/audacious",
    "custom/vis",
    "custom/daemons",
    "tray",
    "custom/vpn",
    "custom/bluetooth",
    "network",
    "pulseaudio",
    "battery"
  ],

  "hyprland/workspaces": {
    "all-outputs": true,
    "format": "{name}:{icon}",
    "tooltip": false,
    "format-icons": {
      "active": "",
      "default": ""
    }
  },

  "clock": {
    "timezone": "Asia/Ho_Chi_Minh",
    "tooltip": false,
    "format": "{:%H:%M:%S - %A, %d}",
    "interval": 1,
    "on-click": "~/.config/waybar/tools/gcal/gcal_click.sh left"
  },

  "custom/singapore": {
    "exec": "~/.config/waybar/scripts/singapore.sh",
    "interval": 1,
    "return-type": "json",
    "tooltip": true
  },

  "custom/gcal": {
    "exec": "~/.config/waybar/tools/gcal/gcal.sh",
    "interval": 300,
    "signal": 1,
    "return-type": "json",
    "on-click": "~/.config/waybar/tools/gcal/gcal_click.sh left",
    "on-click-right": "~/.config/waybar/tools/gcal/gcal_click.sh right",
    "on-click-middle": "~/.config/waybar/tools/gcal/gcal_click.sh middle"
  },

  "custom/vpn": {
    "exec": "~/.config/waybar/scripts/vpn_status.py",
    "interval": 5,
    "return-type": "json",
    "tooltip": true,
    "signal": 8,
    "on-click": "footclient -E --app-id=wifi-tui -e ~/.config/waybar/tools/wifi/.venv/bin/python ~/.config/waybar/tools/wifi/wifitui_curses.py",
    "on-click-right": "~/.config/waybar/scripts/vpn_status.py --disconnect"
  },

  "custom/bluetooth": {
    "exec": "~/.config/waybar/scripts/bluetooth_status.sh",
    "interval": 5,
    "signal": 9,
    "return-type": "json",
    "tooltip": true,
    "on-click": "blueman-manager",
    "on-click-right": "~/.config/waybar/scripts/bluetooth_toggle.sh"
  },

  "network": {
    "format-wifi": " ",
    "format-ethernet": "󰈀 ",
    "format-disconnected": "󰤠 ",
    "interval": 5,
    "tooltip-format": "{essid} ({signalStrength}%)",
    "on-click": "footclient -E --app-id=wifi-tui -e ~/.config/waybar/tools/wifi/.venv/bin/python ~/.config/waybar/tools/wifi/wifitui_curses.py"
  },

  "cpu": {
    "interval": 2,
    "format": " {usage:2>}%",
    "on-click": "footclient -E --app-id=btop -e btop"
  },

  "custom/memory": {
    "exec": "~/.config/waybar/scripts/mem_used.sh",
    "interval": 1,
    "format": " {}",
    "return-type": "json",
    "tooltip": true,
    "on-click": "footclient -E --app-id=btop -e btop"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "",
    "format-icons": {
      "default": ["", "", " "]
    },
    "on-click": "GSK_RENDERER=opengl pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"
  },

  "battery": {
    "format": "{icon} {capacity}%",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "on-click": "~/.config/waybar/tools/battery/battery_click.sh left",
    "on-click-right": "~/.config/waybar/tools/battery/battery_click.sh right"
  },

  "tray": {
    "icon-size": 15,
    "spacing": 10,
    "show-passive-items": false,
    "reverse-direction": false
  },

  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 14,
    "icon-theme": "Papirus",
    "all-outputs": false,
    "tooltip": true,
    "tooltip-format": "{name}",
    "on-click": "activate",
    "on-click-middle": "close"
  },

  "custom/audacious": {
    "exec": "~/.config/waybar/scripts/audacious_status.sh",
    "interval": 1,
    "signal": 2,
    "exec-if": "audtool --playback-status 2>/dev/null | grep -Eq '^(playing|paused)$'",
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "on-click": "audacious --play-pause",
    "on-click-right": "killall audacious",
    "on-scroll-up": "audacious --rew",
    "on-scroll-down": "audacious --fwd"
  },

  "custom/vis": {
    "exec": "~/.config/waybar/tools/vis/waybar-vis -b 12 -r 60 -s 1.0 -d 0.98",
    "tail": true,
    "restart-interval": 2,
    "return-type": "json",
    "format": "{}",
    "tooltip": true
  },

  "custom/daemons": {
    "exec": "~/.config/waybar/tools/daemons/daemons_waybar.sh",
    "signal": 3,
    "on-click": "~/.config/waybar/tools/daemons/daemons_click.sh",
    "return-type": "json"
  },

  "custom/openrouter": {
    "exec": "~/.config/waybar/scripts/openrouter.sh",
    "interval": 30,
    "signal": 5,
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "on-click": "xdg-open https://openrouter.ai/activity"
  }
}
